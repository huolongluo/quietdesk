# QuietDesk model routing (first match wins)
# 1) Amazon Bedrock via Strands default provider
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# 2) Gemini (local / no AWS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3) OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Force the Harbor Auto fixture even if a model key exists
# QUIETDESK_ENGINE=fixture

# Python API
QUIETDESK_HOST=127.0.0.1
QUIETDESK_PORT=8787
QUIETDESK_DATA_DIR=.data

# Next.js
AGENT_URL=http://127.0.0.1:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
